{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "assets/aistudio/Screenshot_*",
      "**/Screenshot_*"
    ],
    "rewrites": [
      {
        "source": "/api/share-preview",
        "function": "shareMeta"
      },
      {
        "source": "/og/**",
        "function": "ogCover"
      },
      {
        "source": "/api/og/**",
        "function": "ogCover"
      },
      {
        "source": "/s/**",
        "function": "shareMeta"
      },
      {
        "source": "/song/**",
        "function": "shareMeta"
      },
      {
        "source": "/tracks/**",
        "function": "shareMeta"
      },
      {
        "source": "/a/**",
        "function": "shareMeta"
      },
      {
        "source": "/artist/**",
        "function": "shareMeta"
      },
      {
        "source": "/artists/**",
        "function": "shareMeta"
      },
      {
        "source": "/charts",
        "function": "shareMeta"
      },
      {
        "source": "/trending",
        "function": "shareMeta"
      },
      {
        "source": "/promo",
        "function": "shareMeta"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "database": "ai-studio-lowervibe-b2e45d28-38e1-4e03-bbe9-11eddd11a756",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
